{
  "name": "reminder-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @reminder/api dev",
    "dev:web": "pnpm --dir apps/web dev",
    "build:api": "pnpm --filter @reminder/api build",
    "build:web": "pnpm --dir apps/web build",
    "build": "pnpm build:api && pnpm build:web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "serverless-http": "^4.0.0"
  }
}